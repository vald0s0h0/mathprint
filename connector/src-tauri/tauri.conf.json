{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MathPrint Connector",
  "version": "1.0.0",
  "identifier": "fr.mathprint.connector",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "MathPrint Connector",
      "width": 480,
      "height": 650,
      "minWidth": 380,
      "minHeight": 560,
      "resizable": true
    }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Impression locale pour MathPrint",
    "longDescription": "Relie MathPrint aux imprimantes configurées sur ce poste.",
    "macOS": {
      "minimumSystemVersion": "10.13",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDUzOTlENkM0OEJGRkUzNTMKUldSVDQvK0x4TmFaVTlTd2dCTFFrWHdZcnppQWkwWEVxdzBEclhpVk52YjRHRzNtcXAvZEF6REUK",
      "endpoints": [
        "https://github.com/vald0s0h0/mathprint/releases/download/connector-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
