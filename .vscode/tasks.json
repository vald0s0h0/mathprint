{
  // Environnement de dev natif (hot-reload) — voir DEV_LOCAL.md.
  //   API :8787 (uvicorn --reload)  →  Vite :5173 (proxy /api)
  //
  // ►►► LE PLUS SIMPLE : Cmd+Shift+B  (= tâche « Dev ▶ » ci-dessous) ◄◄◄
  //     Un seul terminal, les 2 services, Ctrl+C arrête TOUT d'un coup.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev ▶ (tout, 1 terminal)",
      "detail": "Lance API (hot-reload) + Vite dans UN terminal. Ctrl+C arrête tout.",
      "type": "shell",
      "command": "./scripts/dev.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[dev\\]",
          "endsPattern": "les 2 services tournent"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true },
      // Cmd+Shift+B lance cette tâche.
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "dev: api",
      "detail": "API FastAPI en hot-reload (uvicorn --reload, watch backend/app) sur :8787",
      "type": "shell",
      // reload scopé sur le package `app` : sinon les écritures dans
      // mathprint.db / .venv / data déclencheraient des reloads en boucle.
      "command": ".venv/bin/uvicorn app.main:app --reload --reload-dir app --port 8787",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Uvicorn running|Started reloader",
          "endsPattern": "Application startup complete|Uvicorn running"
        }
      },
      "presentation": { "group": "dev", "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "dev: web",
      "detail": "Interface Vite (HMR) sur :5173, proxy /api → 8787",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^\\s*$", "file": 1, "location": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "ready in|Local:"
        }
      },
      "presentation": { "group": "dev", "reveal": "always", "panel": "dedicated" }
    },
    {
      "label": "Dev: tout lancer (2 terminaux séparés)",
      "detail": "Alternative : API + Vite dans 2 terminaux dédiés (logs séparés)",
      "dependsOn": ["dev: api", "dev: web"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
