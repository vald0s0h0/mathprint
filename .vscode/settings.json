{
  // Interpréteur du venv backend (utilisé par les tâches, le débogueur et les tests).
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Tests unitaires backend (pytest) exécutables depuis l'onglet Testing.
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["tests"],
  "python.testing.cwd": "${workspaceFolder}/backend",

  // On ne surveille pas les artefacts d'exécution : évite le bruit et les
  // rechargements parasites de l'éditeur.
  "files.watcherExclude": {
    "**/data/**": true,
    "**/volumes/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/*.db": true
  },
  "search.exclude": {
    "**/data/**": true,
    "**/volumes/**": true,
    "**/dist/**": true
  }
}
