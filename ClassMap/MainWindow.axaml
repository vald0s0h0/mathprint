<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ClassMap"
        x:Class="ClassMap.MainWindow"
        Title="ClassMap"
        Icon="/Assets/classmap.ico"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        CanResize="True"
        MinWidth="180" MinHeight="110"
        Width="640" Height="360"
        WindowStartupLocation="Manual">

  <Window.Styles>
    <Style Selector="Button.tb">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="Foreground" Value="#F0FFFFFF"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.tb:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#40FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.tb:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#70FFFFFF"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.tb:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#F0FFFFFF"/>
    </Style>
    <Style Selector="Button.tb:disabled">
      <Setter Property="Opacity" Value="0.3"/>
    </Style>
    <Style Selector="Button.tb.off PathIcon">
      <Setter Property="Opacity" Value="0.4"/>
    </Style>
    <Style Selector="Button.tb PathIcon">
      <Setter Property="Foreground" Value="#F0FFFFFF"/>
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- Cadre : deux traits très fins (clair + foncé) visibles sur tout fond d'écran. -->
    <Border x:Name="Frame" CornerRadius="6" BorderThickness="1" BorderBrush="#59FFFFFF" Background="#01000000">
      <Border CornerRadius="5" BorderThickness="1" BorderBrush="#30000000">
        <DockPanel>
          <Border x:Name="Toolbar" DockPanel.Dock="Top" Margin="3,3,3,0" CornerRadius="4"
                  Background="#A01E1E1E" Opacity="0.5" Height="20">
            <DockPanel x:Name="ToolbarPanel"/>
          </Border>
          <Border x:Name="Banner" DockPanel.Dock="Bottom" IsVisible="False" Background="#E6B3261E"
                  CornerRadius="3" Margin="3,0,3,3" Padding="6,2">
            <TextBlock x:Name="BannerText" Foreground="White" FontSize="11" TextWrapping="Wrap"/>
          </Border>
          <local:ClassBoard x:Name="Board" Margin="4"/>
        </DockPanel>
      </Border>
    </Border>
    <Panel x:Name="Handles"/>
  </Panel>
</Window>
